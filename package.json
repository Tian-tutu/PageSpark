{
  "name": "pagespark-reading-demo",
  "version": "2.0.1",
  "private": true,
  "description": "PageSpark · AI-powered reading excerpts",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "prepare:book": "node scripts/prepare-book.cjs",
    "check": "node --check electron/main.cjs && node --check src/app.js",
    "dist:win": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "epubjs": "0.3.93",
    "jszip": "3.10.2"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.pagespark.reading",
    "productName": "PageSpark",
    "asar": true,
    "files": [
      "electron/**/*",
      "src/**/*",
      "data/**/*",
      "assets/**/*",
      "scripts/**/*",
      "package.json",
      "pnpm-lock.yaml"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "PageSpark-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "PageSpark"
    }
  }
}
